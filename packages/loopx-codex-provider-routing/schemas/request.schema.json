{
  "$defs": {
    "account": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/$defs/quota"
            },
            {
              "type": "null"
            }
          ]
        },
        "recent_activity": {
          "$ref": "#/$defs/activity"
        },
        "state": {
          "enum": [
            "ready",
            "degraded",
            "unavailable",
            "unknown"
          ]
        }
      },
      "required": [
        "profile_id",
        "state",
        "recent_activity"
      ],
      "type": "object"
    },
    "activity": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "$ref": "#/$defs/count"
        },
        "success": {
          "$ref": "#/$defs/count"
        },
        "window_minutes": {
          "$ref": "#/$defs/positive_integer"
        }
      },
      "required": [
        "success",
        "failed",
        "window_minutes"
      ],
      "type": "object"
    },
    "catalog_reasoning": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "catalog_source": {
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "rings": {
          "items": {
            "$ref": "#/$defs/ring"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/source_route"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        }
      },
      "required": [
        "profiles",
        "routes"
      ],
      "type": "object"
    },
    "change_seam": {
      "enum": [
        "history_projection",
        "integration_candidate",
        "modality_routing",
        "model_catalog",
        "quota_recovery",
        "request_normalizer",
        "retry_policy",
        "route_fallback",
        "sse_lifecycle",
        "transport_pool",
        "tool_transport",
        "cli_configuration"
      ]
    },
    "cli_plan_input": {
      "additionalProperties": false,
      "properties": {
        "catalog_source": {
          "$ref": "#/$defs/catalog_source"
        },
        "codex_version_requirement": {
          "const": "0.160.0"
        },
        "deployment_ref": {
          "$ref": "#/$defs/symbolic_id"
        },
        "model_selector": {
          "$ref": "#/$defs/model_selector"
        },
        "provider_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoning_effort"
        },
        "required_capabilities": {
          "$ref": "#/$defs/required_capabilities"
        },
        "route_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "routing_revision": {
          "$ref": "#/$defs/symbolic_id"
        },
        "service_tier": {
          "enum": [
            "default",
            "priority"
          ]
        }
      },
      "required": [
        "catalog_source",
        "route_id",
        "routing_revision",
        "deployment_ref",
        "provider_id",
        "model_selector",
        "reasoning_effort",
        "service_tier",
        "required_capabilities",
        "codex_version_requirement"
      ],
      "type": "object"
    },
    "count": {
      "minimum": 0,
      "type": "integer"
    },
    "display_label": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^(?! +$)(?!.*(?:@|[Bb][Ee][Aa][Rr][Ee][Rr] |\\bsk-[A-Za-z0-9_-]{12,}|/|\\\\|\\n|\\r))[A-Za-z0-9 \u00b7\u2192\u2014()_.:+-]+$",
      "type": "string"
    },
    "execution_observation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "attempted_profiles": {
              "items": {
                "$ref": "#/$defs/symbolic_id"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "fast": {
              "type": "boolean"
            },
            "modality": {
              "enum": [
                "text",
                "image"
              ]
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "outcome": {
              "const": "success"
            },
            "required_tool_transport": {
              "$ref": "#/$defs/tool_transport"
            },
            "route_slug": {
              "$ref": "#/$defs/model_selector"
            },
            "selected_profile": {
              "$ref": "#/$defs/symbolic_id"
            }
          },
          "required": [
            "route_slug",
            "modality",
            "observed_at",
            "attempted_profiles",
            "selected_profile",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempted_profiles": {
              "items": {
                "$ref": "#/$defs/symbolic_id"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "fast": {
              "type": "boolean"
            },
            "modality": {
              "enum": [
                "text",
                "image"
              ]
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "outcome": {
              "const": "failed"
            },
            "required_tool_transport": {
              "$ref": "#/$defs/tool_transport"
            },
            "route_slug": {
              "$ref": "#/$defs/model_selector"
            }
          },
          "required": [
            "route_slug",
            "modality",
            "observed_at",
            "attempted_profiles",
            "outcome"
          ],
          "type": "object"
        }
      ]
    },
    "fast_selector": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "$ref": "#/$defs/display_label"
        },
        "fallback_policy": {
          "const": "fast_capable_only"
        }
      },
      "required": [
        "display_name",
        "fallback_policy"
      ],
      "type": "object"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "host_identity": {
      "additionalProperties": false,
      "properties": {
        "projection": {
          "const": "not_projected"
        },
        "route_binding": {
          "const": "none"
        },
        "state": {
          "enum": [
            "not_applicable",
            "unknown",
            "retained"
          ]
        }
      },
      "required": [
        "state",
        "projection",
        "route_binding"
      ],
      "type": "object"
    },
    "integration_input": {
      "additionalProperties": false,
      "properties": {
        "base_ref": {
          "$ref": "#/$defs/public_ref"
        },
        "integration_branch": {
          "$ref": "#/$defs/public_ref"
        },
        "last_sync": {
          "$ref": "#/$defs/integration_receipt"
        },
        "observed": {
          "$ref": "#/$defs/integration_receipt"
        },
        "required_seams": {
          "items": {
            "$ref": "#/$defs/change_seam"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/integration_source"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": false
        }
      },
      "required": [
        "base_ref",
        "integration_branch",
        "required_seams",
        "sources",
        "observed",
        "last_sync"
      ],
      "type": "object"
    },
    "integration_receipt": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "integration_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "source_heads": {
          "additionalProperties": {
            "$ref": "#/$defs/git_sha"
          },
          "propertyNames": {
            "$ref": "#/$defs/symbolic_id"
          },
          "type": "object"
        }
      },
      "required": [
        "base_sha",
        "integration_sha",
        "source_heads"
      ],
      "type": "object"
    },
    "integration_source": {
      "additionalProperties": false,
      "properties": {
        "changed_seams": {
          "items": {
            "$ref": "#/$defs/change_seam"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "kind": {
          "enum": [
            "pull_request",
            "public_safe_patch"
          ]
        },
        "ref": {
          "$ref": "#/$defs/public_ref"
        }
      },
      "required": [
        "id",
        "kind",
        "ref",
        "head_sha",
        "changed_seams"
      ],
      "type": "object"
    },
    "modalities": {
      "items": {
        "enum": [
          "text",
          "image"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "model_selector": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})(?!.*\\.\\.)[a-z0-9][a-z0-9./-]{0,127}$",
      "type": "string"
    },
    "normalization_input": {
      "additionalProperties": false,
      "properties": {
        "catalog_source": {
          "$ref": "#/$defs/catalog_source"
        },
        "model_selector": {
          "$ref": "#/$defs/model_selector"
        },
        "required_modalities": {
          "$ref": "#/$defs/modalities"
        },
        "required_tool_transport": {
          "$ref": "#/$defs/tool_transport"
        },
        "service_tier": {
          "enum": [
            "default",
            "priority"
          ]
        }
      },
      "required": [
        "catalog_source",
        "model_selector"
      ],
      "type": "object"
    },
    "outage_input": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cooldown_expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "cooldown_invalidated": {
              "type": "boolean"
            },
            "cooldown_source_observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "degraded_fallback_binding_cleared": {
              "type": "boolean"
            },
            "fallback_attempted": {
              "type": "boolean"
            },
            "native_capability_requested": {
              "type": "boolean"
            },
            "outage_ended": {
              "const": true
            },
            "outage_ended_observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "post_recovery_probe": {
              "enum": [
                "not_attempted",
                "success",
                "still_outage",
                "transport_failed"
              ]
            }
          },
          "required": [
            "outage_ended",
            "outage_ended_observed_at",
            "cooldown_source_observed_at",
            "cooldown_expires_at",
            "cooldown_invalidated",
            "post_recovery_probe",
            "degraded_fallback_binding_cleared",
            "native_capability_requested",
            "fallback_attempted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cooldown_expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "cooldown_invalidated": {
              "type": "boolean"
            },
            "cooldown_source_observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "degraded_fallback_binding_cleared": {
              "type": "boolean"
            },
            "fallback_attempted": {
              "type": "boolean"
            },
            "native_capability_requested": {
              "type": "boolean"
            },
            "outage_ended": {
              "const": false
            },
            "outage_ended_observed_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "post_recovery_probe": {
              "enum": [
                "not_attempted",
                "success",
                "still_outage",
                "transport_failed"
              ]
            }
          },
          "required": [
            "outage_ended",
            "cooldown_source_observed_at",
            "cooldown_expires_at",
            "cooldown_invalidated",
            "post_recovery_probe",
            "degraded_fallback_binding_cleared",
            "native_capability_requested",
            "fallback_attempted"
          ],
          "type": "object"
        }
      ]
    },
    "percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "positive_integer": {
      "minimum": 1,
      "type": "integer"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "input_modalities": {
          "$ref": "#/$defs/modalities"
        },
        "priority": {
          "type": "integer"
        },
        "provider": {
          "enum": [
            "codex",
            "openai_compatibility"
          ]
        },
        "supports_fast": {
          "type": "boolean"
        },
        "tool_transports": {
          "items": {
            "$ref": "#/$defs/tool_transport"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "provider",
        "priority",
        "input_modalities"
      ],
      "type": "object"
    },
    "public_ref": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
      "type": "string"
    },
    "quota": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/quota_window"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        }
      },
      "required": [
        "observed_at"
      ],
      "type": "object"
    },
    "quota_input": {
      "additionalProperties": false,
      "properties": {
        "cooldown_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "cooldown_invalidated": {
          "type": "boolean"
        },
        "cooldown_source_observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "fallback_attempted": {
          "type": "boolean"
        },
        "post_reset_probe": {
          "enum": [
            "not_attempted",
            "success",
            "quota_limited",
            "transport_failed"
          ]
        },
        "reset_observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reset_outcome": {
          "enum": [
            "applied",
            "not_applied"
          ]
        }
      },
      "required": [
        "reset_outcome",
        "reset_observed_at",
        "cooldown_source_observed_at",
        "cooldown_expires_at",
        "cooldown_invalidated",
        "fallback_attempted",
        "post_reset_probe"
      ],
      "type": "object"
    },
    "quota_window": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "reset_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "used_percent": {
          "$ref": "#/$defs/percent"
        },
        "window_minutes": {
          "$ref": "#/$defs/positive_integer"
        }
      },
      "required": [
        "id",
        "used_percent",
        "window_minutes"
      ],
      "type": "object"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "required_capabilities": {
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "$ref": "#/$defs/modalities"
        },
        "tool_transport": {
          "$ref": "#/$defs/tool_transport"
        }
      },
      "required": [
        "modalities",
        "tool_transport"
      ],
      "type": "object"
    },
    "ring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "max_cycles": {
          "const": 1
        },
        "members": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "members",
        "max_cycles"
      ],
      "type": "object"
    },
    "snapshot_input": {
      "additionalProperties": false,
      "properties": {
        "catalog_readback_matches": {
          "type": "boolean"
        },
        "codex_cli_version": {
          "const": "0.160.0"
        },
        "profile_config_parsed": {
          "type": "boolean"
        },
        "provider_readback_matches": {
          "type": "boolean"
        }
      },
      "required": [
        "codex_cli_version",
        "profile_config_parsed",
        "catalog_readback_matches",
        "provider_readback_matches"
      ],
      "type": "object"
    },
    "source_route": {
      "additionalProperties": false,
      "properties": {
        "alias_for": {
          "$ref": "#/$defs/model_selector"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "display_name": {
          "$ref": "#/$defs/display_label"
        },
        "entrypoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/symbolic_id"
            },
            {
              "const": "affinity_then_first"
            }
          ]
        },
        "fallback_tail": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "fast_selector": {
          "$ref": "#/$defs/fast_selector"
        },
        "input_modalities": {
          "$ref": "#/$defs/modalities"
        },
        "mode": {
          "enum": [
            "auto",
            "preferred",
            "manual",
            "alias"
          ]
        },
        "reasoning_levels": {
          "items": {
            "$ref": "#/$defs/catalog_reasoning"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "ring": {
          "$ref": "#/$defs/symbolic_id"
        },
        "slug": {
          "$ref": "#/$defs/model_selector"
        },
        "supports_fast": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "display_name",
        "mode",
        "input_modalities"
      ],
      "type": "object"
    },
    "status_input": {
      "additionalProperties": false,
      "properties": {
        "account_observations": {
          "items": {
            "$ref": "#/$defs/account"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "catalog_source": {
          "$ref": "#/$defs/catalog_source"
        },
        "credential_free": {
          "const": true
        },
        "execution_observation": {
          "$ref": "#/$defs/execution_observation"
        },
        "host_identity": {
          "$ref": "#/$defs/host_identity"
        },
        "schema_version": {
          "const": "codex_provider_routing_runtime_status_v1"
        }
      },
      "required": [
        "catalog_source",
        "host_identity",
        "execution_observation",
        "account_observations"
      ],
      "type": "object"
    },
    "stream_input": {
      "additionalProperties": false,
      "properties": {
        "effective_idle_timeout_ms": {
          "$ref": "#/$defs/positive_integer"
        },
        "effective_stream_max_retries": {
          "$ref": "#/$defs/count"
        },
        "events_forwarded_incrementally": {
          "type": "boolean"
        },
        "failure_kind": {
          "const": "sse_idle_timeout"
        },
        "history_preserved": {
          "type": "boolean"
        },
        "observed_idle_gap_ms": {
          "$ref": "#/$defs/positive_integer"
        },
        "previous_idle_timeout_ms": {
          "$ref": "#/$defs/positive_integer"
        },
        "previous_stream_max_retries": {
          "$ref": "#/$defs/count"
        },
        "same_home": {
          "type": "boolean"
        },
        "same_session": {
          "type": "boolean"
        },
        "settings_readback_matches": {
          "type": "boolean"
        },
        "terminal_event_source": {
          "enum": [
            "upstream",
            "adapter",
            "missing"
          ]
        },
        "text_response_completed": {
          "type": "boolean"
        },
        "tool_round_trip_completed": {
          "type": "boolean"
        }
      },
      "required": [
        "failure_kind",
        "previous_idle_timeout_ms",
        "effective_idle_timeout_ms",
        "observed_idle_gap_ms",
        "previous_stream_max_retries",
        "effective_stream_max_retries",
        "events_forwarded_incrementally",
        "same_session",
        "same_home",
        "history_preserved",
        "text_response_completed",
        "tool_round_trip_completed",
        "settings_readback_matches",
        "terminal_event_source"
      ],
      "type": "object"
    },
    "symbolic_id": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "tool_input": {
      "additionalProperties": false,
      "properties": {
        "dispatch_outcome": {
          "enum": [
            "completed",
            "not_dispatched",
            "rejected_incompatible_payload"
          ]
