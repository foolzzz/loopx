{
  "$defs": {
    "account_result": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/$defs/quota_result"
            },
            {
              "type": "null"
            }
          ]
        },
        "recent_activity": {
          "$ref": "#/$defs/activity"
        },
        "state": {
          "enum": [
            "ready",
            "degraded",
            "unavailable",
            "unknown"
          ]
        }
      },
      "required": [
        "profile_id",
        "state",
        "recent_activity",
        "quota"
      ],
      "type": "object"
    },
    "activity": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "$ref": "#/$defs/count"
        },
        "success": {
          "$ref": "#/$defs/count"
        },
        "window_minutes": {
          "$ref": "#/$defs/positive_integer"
        }
      },
      "required": [
        "success",
        "failed",
        "window_minutes"
      ],
      "type": "object"
    },
    "catalog_reasoning": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "catalog_result": {
      "additionalProperties": false,
      "properties": {
        "credential_free": {
          "const": true
        },
        "default_service_tier": {
          "const": "default"
        },
        "fast_request_service_tier": {
          "const": "priority"
        },
        "fast_selector_prefix": {
          "const": "fast/"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/compiled_profile"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "rings": {
          "items": {
            "$ref": "#/$defs/ring"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/route_result"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "schema_version": {
          "const": "codex_provider_routing_catalog_v1"
        },
        "selector_rows": {
          "items": {
            "$ref": "#/$defs/selector_result"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "credential_free",
        "default_service_tier",
        "fast_selector_prefix",
        "fast_request_service_tier",
        "profiles",
        "rings",
        "routes",
        "selector_rows"
      ],
      "type": "object"
    },
    "change_seam": {
      "enum": [
        "history_projection",
        "integration_candidate",
        "modality_routing",
        "model_catalog",
        "quota_recovery",
        "request_normalizer",
        "retry_policy",
        "route_fallback",
        "sse_lifecycle",
        "transport_pool",
        "tool_transport",
        "cli_configuration"
      ]
    },
    "check": {
      "additionalProperties": false,
      "properties": {
        "failure_code": {
          "$ref": "#/$defs/code"
        },
        "id": {
          "$ref": "#/$defs/code"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "passed",
        "failure_code"
      ],
      "type": "object"
    },
    "cli_plan_result": {
      "additionalProperties": false,
      "properties": {
        "codex_version_requirement": {
          "const": "0.160.0"
        },
        "deployment_ref": {
          "$ref": "#/$defs/symbolic_id"
        },
        "eligible_candidates": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "model_selector": {
          "$ref": "#/$defs/model_selector"
        },
        "online_qualification": {
          "const": "held"
        },
        "provider_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "provider_overrides": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "type": "object"
        },
        "qualification": {
          "const": "declaration_only"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoning_effort"
        },
        "required_capabilities": {
          "$ref": "#/$defs/required_capabilities"
        },
        "route_id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "routing_revision": {
          "$ref": "#/$defs/symbolic_id"
        },
        "schema_version": {
          "const": "codex_cli_route_launch_plan_v1"
        },
        "service_tier": {
          "enum": [
            "default",
            "priority"
          ]
        }
      },
      "required": [
        "schema_version",
        "route_id",
        "routing_revision",
        "deployment_ref",
        "provider_id",
        "model_selector",
        "reasoning_effort",
        "service_tier",
        "required_capabilities",
        "codex_version_requirement",
        "eligible_candidates",
        "qualification",
        "online_qualification",
        "provider_overrides"
      ],
      "type": "object"
    },
    "code": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})[a-z][a-z0-9_]{0,95}$",
      "type": "string"
    },
    "compiled_profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "input_modalities": {
          "$ref": "#/$defs/modalities"
        },
        "priority": {
          "type": "integer"
        },
        "provider": {
          "enum": [
            "codex",
            "openai_compatibility"
          ]
        },
        "supports_fast": {
          "type": "boolean"
        },
        "tool_transports": {
          "items": {
            "$ref": "#/$defs/tool_transport"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "provider",
        "priority",
        "input_modalities",
        "tool_transports",
        "supports_fast"
      ],
      "type": "object"
    },
    "count": {
      "minimum": 0,
      "type": "integer"
    },
    "display_label": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^(?! +$)(?!.*(?:@|[Bb][Ee][Aa][Rr][Ee][Rr] |\\bsk-[A-Za-z0-9_-]{12,}|/|\\\\|\\n|\\r))[A-Za-z0-9 \u00b7\u2192\u2014()_.:+-]+$",
      "type": "string"
    },
    "drift": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "base_moved",
                "integration_head_moved"
              ]
            },
            "last_sync_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "observed_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "ref": {
              "$ref": "#/$defs/public_ref"
            }
          },
          "required": [
            "kind",
            "ref",
            "last_sync_sha",
            "observed_sha"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_moved"
            },
            "last_sync_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "observed_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "source_id": {
              "$ref": "#/$defs/symbolic_id"
            }
          },
          "required": [
            "kind",
            "source_id",
            "last_sync_sha",
            "observed_sha"
          ],
          "type": "object"
        }
      ]
    },
    "execution_result": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "attempted_profiles": {
              "items": {
                "$ref": "#/$defs/symbolic_id"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "fallback_used": {
              "type": "boolean"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "outcome": {
              "const": "success"
            },
            "selected_profile": {
              "$ref": "#/$defs/symbolic_id"
            }
          },
          "required": [
            "observed_at",
            "attempted_profiles",
            "outcome",
            "fallback_used",
            "selected_profile"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempted_profiles": {
              "items": {
                "$ref": "#/$defs/symbolic_id"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "fallback_used": {
              "type": "boolean"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "outcome": {
              "const": "failed"
            }
          },
          "required": [
            "observed_at",
            "attempted_profiles",
            "outcome",
            "fallback_used"
          ],
          "type": "object"
        }
      ]
    },
    "fast_selector": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "$ref": "#/$defs/display_label"
        },
        "fallback_policy": {
          "const": "fast_capable_only"
        }
      },
      "required": [
        "display_name",
        "fallback_policy"
      ],
      "type": "object"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "host_identity": {
      "additionalProperties": false,
      "properties": {
        "projection": {
          "const": "not_projected"
        },
        "route_binding": {
          "const": "none"
        },
        "state": {
          "enum": [
            "not_applicable",
            "unknown",
            "retained"
          ]
        }
      },
      "required": [
        "state",
        "projection",
        "route_binding"
      ],
      "type": "object"
    },
    "integration_result": {
      "additionalProperties": false,
      "properties": {
        "core_integration_plan": {
          "additionalProperties": false,
          "properties": {
            "base_ref": {
              "$ref": "#/$defs/public_ref"
            },
            "integration_branch": {
              "$ref": "#/$defs/public_ref"
            },
            "source_refs": {
              "items": {
                "$ref": "#/$defs/public_ref"
              },
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "base_ref",
            "integration_branch",
            "source_refs"
          ],
          "type": "object"
        },
        "covered_seams": {
          "items": {
            "$ref": "#/$defs/change_seam"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "deployment_contract": {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "const": "content_addressed_binary_with_sha256"
            },
            "rollback_trigger": {
              "const": "any_failed_readback_or_unexplained_regression"
            },
            "sequence": {
              "items": {
                "$ref": "#/$defs/code"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "session_store_policy": {
              "const": "preserve_in_place_never_copy_or_delete"
            }
          },
          "required": [
            "artifact",
            "sequence",
            "rollback_trigger",
            "session_store_policy"
          ],
          "type": "object"
        },
        "drift_reasons": {
          "items": {
            "$ref": "#/$defs/drift"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "effect_boundary": {
          "const": "read_only_public_safe_plan"
        },
        "reconcile_steps": {
          "items": {
            "$ref": "#/$defs/code"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "required_seams": {
          "items": {
            "$ref": "#/$defs/change_seam"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "codex_provider_integration_candidate_v0"
        },
        "source_order": {
          "items": {
            "$ref": "#/$defs/integration_source"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": false
        },
        "status": {
          "enum": [
            "sync_required",
            "in_sync"
          ]
        },
        "sync_required": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "status",
        "sync_required",
        "drift_reasons",
        "required_seams",
        "covered_seams",
        "source_order",
        "core_integration_plan",
        "reconcile_steps",
        "deployment_contract",
        "effect_boundary"
      ],
      "type": "object"
    },
    "integration_source": {
      "additionalProperties": false,
      "properties": {
        "changed_seams": {
          "items": {
            "$ref": "#/$defs/change_seam"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "kind": {
          "enum": [
            "pull_request",
            "public_safe_patch"
          ]
        },
        "ref": {
          "$ref": "#/$defs/public_ref"
        }
      },
      "required": [
        "id",
        "kind",
        "ref",
        "head_sha",
        "changed_seams"
      ],
      "type": "object"
    },
    "modalities": {
      "items": {
        "enum": [
          "text",
          "image"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "model_selector": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})(?!.*\\.\\.)[a-z0-9][a-z0-9./-]{0,127}$",
      "type": "string"
    },
    "normalization_result": {
      "additionalProperties": false,
      "properties": {
        "default_service_tier": {
          "enum": [
            "default",
            "fast"
          ]
        },
        "eligible_candidates": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "fallback_policy": {
          "enum": [
            "route_default",
            "fast_capable_only",
            "required_tool_transport_only",
            "fast_and_required_tool_transport_only"
          ]
        },
        "normalized_model_selector": {
          "$ref": "#/$defs/model_selector"
        },
        "original_model_selector": {
          "$ref": "#/$defs/model_selector"
        },
        "required_modalities": {
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "required_tool_transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/tool_transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_tier": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "preserve",
                "force_priority"
              ]
            },
            "value": {
              "enum": [
                "default",
                "priority"
              ]
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      },
      "required": [
        "original_model_selector",
        "normalized_model_selector",
        "default_service_tier",
        "service_tier",
        "fallback_policy",
        "eligible_candidates",
        "required_tool_transport",
        "required_modalities"
      ],
      "type": "object"
    },
    "outage_result": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "effect_boundary": {
          "const": "content_free_observation_only"
        },
        "expected_action": {
          "enum": [
            "invalidate_cooldown_and_revalidate_affinity",
            "retain_cooldown_until_recovery_observed"
          ]
        },
        "failure_codes": {
          "items": {
            "$ref": "#/$defs/code"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "outage_ended": {
          "type": "boolean"
        },
        "qualified": {
          "type": "boolean"
        },
        "required_contract": {
          "additionalProperties": false,
          "properties": {
            "degraded_affinity": {
              "const": "fallback_binding_revalidated_before_native_capability_request"
            },
            "incident_cooldown": {
              "const": "outage_end_newer_than_source_invalidates_cooldown"
            },
            "native_capability": {
              "const": "fail_closed_when_no_eligible_native_provider"
            },
            "recovery_gate": {
              "const": "bounded_probe_before_fallback_admission"
            }
          },
          "required": [
            "incident_cooldown",
            "recovery_gate",
            "degraded_affinity",
            "native_capability"
          ],
          "type": "object"
        },
        "responsible_layer": {
          "const": "cpa_provider_health_state_and_selector"
        },
        "schema_version": {
          "const": "codex_outage_recovery_qualification_v0"
        }
      },
      "required": [
        "qualified",
        "failure_codes",
        "checks",
        "effect_boundary",
        "schema_version",
        "outage_ended",
        "expected_action",
        "responsible_layer",
        "required_contract"
      ],
      "type": "object"
    },
    "percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "positive_integer": {
      "minimum": 1,
      "type": "integer"
    },
    "public_ref": {
      "pattern": "^(?!.*\\bsk-[A-Za-z0-9_-]{12,})(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
      "type": "string"
    },
    "quota_recovery_result": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "effect_boundary": {
          "const": "content_free_observation_only"
        },
        "expected_action": {
          "enum": [
            "invalidate_and_probe",
            "retain_cooldown"
          ]
        },
        "failure_codes": {
          "items": {
            "$ref": "#/$defs/code"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        },
        "qualified": {
          "type": "boolean"
        },
        "required_contract": {
          "additionalProperties": false,
          "properties": {
            "fallback_gate": {
              "const": "probe_recovered_account_before_fallback"
            },
            "new_quota_limit": {
              "const": "a_new_probe_may_create_a_new_cooldown"
            },
            "reset_receipt_ordering": {
              "const": "newer_reset_invalidates_older_cooldown"
            }
          },
          "required": [
            "reset_receipt_ordering",
            "fallback_gate",
            "new_quota_limit"
          ],
          "type": "object"
        },
        "reset_supersedes_cooldown": {
          "type": "boolean"
        },
        "responsible_layer": {
          "const": "cpa_provider_health_state"
        },
        "schema_version": {
          "const": "codex_quota_recovery_qualification_v0"
        }
      },
      "required": [
        "qualified",
        "failure_codes",
        "checks",
        "effect_boundary",
        "schema_version",
        "reset_supersedes_cooldown",
        "expected_action",
        "responsible_layer",
        "required_contract"
      ],
      "type": "object"
    },
    "quota_result": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/quota_window_result"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": false
        }
      },
      "required": [
        "observed_at",
        "windows"
      ],
      "type": "object"
    },
    "quota_window_result": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "remaining_percent": {
          "$ref": "#/$defs/percent"
        },
        "reset_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "used_percent": {
          "$ref": "#/$defs/percent"
        },
        "window_minutes": {
          "$ref": "#/$defs/positive_integer"
        }
      },
      "required": [
        "id",
        "used_percent",
        "window_minutes",
        "reset_at",
        "remaining_percent"
      ],
      "type": "object"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "required_capabilities": {
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "$ref": "#/$defs/modalities"
        },
        "tool_transport": {
          "$ref": "#/$defs/tool_transport"
        }
      },
      "required": [
        "modalities",
        "tool_transport"
      ],
      "type": "object"
    },
    "ring": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/symbolic_id"
        },
        "max_cycles": {
          "const": 1
        },
        "members": {
          "items": {
            "$ref": "#/$defs/symbolic_id"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "members",
        "max_cycles"
      ],
      "type": "object"
    },
    "route_result": {
      "additionalProperties": false,
